<%@ Master Language="VB" AutoEventWireup="true" CodeBehind="Site.master.vb" Inherits="Transporte.SiteMaster" %>



<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Sistema Transporte</title>

    <webopt:bundlereference runat="server" path="~/Content/css" />
</head>

<body>
    <form runat="server">

        <asp:ScriptManager runat="server" />

        <!-- MENÚ -->
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" runat="server" href="~/UI/Menu.aspx">
                    Sistema Transporte
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menuPrincipal">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="menuPrincipal">

                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/UI/frmPersonas.aspx">Personas</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/UI/Usuarios.aspx">Usuarios</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/UI/Propietarios.aspx">Propietarios</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/UI/frmVehiculos.aspx">Vehículos</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/UI/TipoMulta.aspx">Tipos de Multa</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/UI/frmMultas.aspx">Multas</a></li>
                    </ul>

                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <asp:Label ID="lblUsuario" runat="server"
                                CssClass="nav-link text-white fw-bold" />
                        </li>
                        <li class="nav-item">
                            <asp:LinkButton ID="btnSalir" runat="server"
                                CssClass="nav-link text-warning"
                                OnClick="btnSalir_Click">
                                Cerrar sesión
                            </asp:LinkButton>
                        </li>
                    </ul>

                </div>
            </div>
        </nav>

        <!-- CONTENIDO -->
        <div class="container mt-4">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server" />
            <hr />
            <footer class="text-center">
                <p>&copy; <%: DateTime.Now.Year %> - Sistema Transporte</p>
            </footer>
        </div>

    </form>
</body>
</html>
